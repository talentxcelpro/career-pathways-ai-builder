{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://talentxcel.in/employer",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ]
}