# TalentXcel MCP Server Environment Variables
# Copy this file to .env.local for local development

# Supabase (required)
SUPABASE_URL=https://dthlgsnakhoftinssokm.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for service-role operations (NEVER expose to MCP clients)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# MCP transport mode: stdio (default) or http
TALENTXCEL_MCP_TRANSPORT=stdio

# HTTP mode settings (remote deployment only)
MCP_PORT=3100
MCP_HOST=0.0.0.0
