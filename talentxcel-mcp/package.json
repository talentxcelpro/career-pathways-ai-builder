{
  "name": "@talentxcel/mcp-server",
  "version": "1.0.0",
  "description": "TalentXcel Universal MCP Server — independent, production-grade",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
