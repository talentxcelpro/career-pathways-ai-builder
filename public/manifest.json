    },
    {
      "src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "CareerCatalyst Dashboard"
    },
    {
      "src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "CareerCatalyst Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Find Jobs",
      "short_name": "Jobs",
      "description": "Search and apply for jobs",
      "url": "/jobs",
      "icons": [{"src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png", "sizes": "96x96"}]
    },
    {
      "name": "Network",
      "short_name": "Network",
      "description": "Connect with professionals",
      "url": "/network",
      "icons": [{"src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png", "sizes": "96x96"}]
    },
    {
      "name": "Learn",
      "short_name": "Learn",
      "description": "Develop your skills",
      "url": "/learn",
      "icons": [{"src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png", "sizes": "96x96"}]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-resume",
      "accept": {
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      },
      "icons": [
        {
          "src": "/lovable-uploads/2f30b9a2-a492-4725-b98c-334796c21e32.png",
          "sizes": "96x96"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+careercatalyst",
      "url": "/connect?target=%s"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 480
  }
}