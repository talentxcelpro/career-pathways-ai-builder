  "name": "CareerCatalyst - AI-Powered Career Platform",
  "short_name": "CareerCatalyst",
  "description": "Transform your career with AI-powered tools and professional networking",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#0066FF",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "education"],
  "icons": [
