import { CompanyLogoAvatar } from './jobmatch/CompanyLogoAvatar';
import { PlatformEcosystemSidebar } from './jobmatch/PlatformEcosystemSidebar';

const CORE_ORGANIZATIONS = [
  'bhel', 'isro', 'drdo', 'iocl', 'railway', 'rrb', 'ntpc', 'ongc', 'sail',
  'hal', 'bel', 'powergrid', 'coal india', 'lic', 'sbi', 'rbi', 'upsc', 'ssc'
];

const CORE_KEYWORDS = [
  'mechanical', 'civil', 'electrical', 'safety', 'officer', 'hospital', 
  'logistics', 'supply chain', 'manufacturing', 'public', 'government', 
  'audit', 'energy', 'psu', 'technician', 'plant', 'maintenance', 'site', 'trainee', 'sub-engineer'
];

const TECH_KEYWORDS = [
  'software', 'developer', 'frontend', 'backend', 'full stack', 'react', 
  'node', 'python', 'java', 'cloud', 'devops', 'data', 'ai', 'machine learning', 
  'qa', 'automation', 'cyber', 'security', 'it support', 'freshers', 'engineer', 
  'architect', 'sre', 'tech lead', 'programmer', 'analyst', 'database', 'platform'
];

const NON_TECH_KEYWORDS = [
  'marketing', 'sales', 'operations', 'customer', 'business', 'hr', 
  'human resources', 'finance', 'account', 'content', 'writer', 'support', 
  'management trainee', 'relationship manager', 'administration', 'hospitality',
  'telecaller', 'recruiter', 'lead generation', 'procurement', 'bpo', 'executive'
];

function categorizeJob(title: string, company?: string, department?: string, industry?: string): 'tech' | 'non-tech' | 'core' {
  const t = (title || '').toLowerCase();
  const c = (company || '').toLowerCase();
  const d = (department || '').toLowerCase();
  const ind = (industry || '').toLowerCase();
  const full = `${t} ${c} ${d} ${ind}`;

  if (CORE_ORGANIZATIONS.some(org => c.includes(org) || t.includes(org))) return 'core';
  if (CORE_KEYWORDS.some(k => full.includes(k))) return 'core';
  if (TECH_KEYWORDS.some(k => t.includes(k))) return 'tech';
  if (NON_TECH_KEYWORDS.some(k => full.includes(k))) return 'non-tech';
  if (d.includes('tech') || d.includes('it') || ind.includes('tech') || ind.includes('software')) return 'tech';
  return 'non-tech';
}

function generateSlug(title: string, id: string): string {
  const cleanTitle = (title || 'job')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
  return `${cleanTitle}-${id}`;
}

function formatSalary(min?: number, max?: number): string | null {
  if (!min || min <= 0) return null;
  const minLakhs = (min / 100000).toFixed(1);
  if (!max || max === min) return `₹${minLakhs} LPA`;
  const maxLakhs = (max / 100000).toFixed(1);
  return `₹${minLakhs}L – ₹${maxLakhs}L CTC`;
}

export const JobMatchProduct: React.FC = () => {
  const [searchParams, setSearchParams] = useSearchParams();
  const navigate = useNavigate();

  // Active View Tab (discover | match | tracker | saved | employer | talent | interview)
  const getInitialTab = (): string => {
    const param = searchParams.get('tab');
    if (param) return param;
    if (typeof window !== 'undefined') {
      const p = window.location.pathname.toLowerCase();
      if (p.includes('/post') || p.includes('/hire')) return 'employer';
      if (p.includes('/manage')) return 'employer';
      if (p.includes('/tracker') || p.includes('/applications') || p.includes('/applied')) return 'tracker';
      if (p.includes('/saved')) return 'saved';
      if (p.includes('/talent') || p.includes('/candidates')) return 'talent';
      if (p.includes('/match')) return 'match';
      if (p.includes('/interview')) return 'interview';
    }
    return 'discover';
  };

  const activeTab = getInitialTab();

  const setActiveTab = (tab: string) => {
    setSearchParams(prev => {
      const next = new URLSearchParams(prev);
      next.set('tab', tab);
      return next;
    });
  };

  const [searchTerm, setSearchTerm] = useState('');
  const [selectedCity, setSelectedCity] = useState('all');
  const [selectedExperience, setSelectedExperience] = useState('all');
  const [selectedSalary, setSelectedSalary] = useState('all');
  const [selectedWorkMode, setSelectedWorkMode] = useState('all');
  const [selectedEmploymentType, setSelectedEmploymentType] = useState('all');
  const [sortBy, setSortBy] = useState<'latest' | 'salary_high' | 'experience'>('latest');
  const [currentPage, setCurrentPage] = useState(1);
  const pageSize = 12;
  const [savedJobIds, setSavedJobIds] = useState<string[]>(() => {
    try {
      return JSON.parse(localStorage.getItem('txc_saved_jobs') || '[]');
    } catch {
      return [];
    }
  });

  const [activeCategory, setActiveCategory] = useState<'all' | 'tech' | 'non-tech' | 'core'>('all');
  const [jobs, setJobs] = useState<JobDetailItem[]>([]);
  const [totalCount, setTotalCount] = useState<number>(2236);
  const [loading, setLoading] = useState(true);
  const [errorState, setErrorState] = useState<string | null>(null);

  const [trackedApplicationsCount, setTrackedApplicationsCount] = useState<number>(() => {
    try {
      const arr = JSON.parse(localStorage.getItem('txc_tracked_applications') || '[]');
      return arr.length;
    } catch {
      return 0;
    }
  });

  // Modals & Drawers state
  const [selectedJobForDetail, setSelectedJobForDetail] = useState<JobDetailItem | null>(null);
  const [selectedJobForApply, setSelectedJobForApply] = useState<JobDetailItem | null>(null);
  const [selectedJobForInterview, setSelectedJobForInterview] = useState<JobDetailItem | null>(null);
  const [platformSidebarOpen, setPlatformSidebarOpen] = useState(false);

  useEffect(() => {
    conversionTelemetry.track('landing_view', { product: 'jobmatch_os', universe: 'JOBS' });
    fetchJobs();
  }, []);

  const fetchJobs = async () => {
    setLoading(true);
    setErrorState(null);
    try {
      // 1. Fetch exact live inventory count
      const { count } = await supabase
        .from('jobs')
        .select('*', { count: 'exact', head: true })
        .eq('is_active', true);

      if (count && count > 0) {
        setTotalCount(count);
      }

      // 2. Fetch authentic active vacancies directly from Supabase
      const { data, error } = await supabase
        .from('jobs')
        .select('id, title, company_name, location, location_city, location_state, employment_type, is_remote, work_mode, salary_min, salary_max, department, industry, external_url, skills_required, application_deadline, expires_at, created_at, job_summary, min_experience, max_experience')
        .eq('is_active', true)
        .order('created_at', { ascending: false })
        .limit(500);

      if (error) {
        console.error('Supabase jobs fetch error:', error);
        setErrorState(error.message || 'Unable to connect to live jobs database');
        setJobs([]);
        return;
      }

      const now = new Date();
      const unexpired = (data || []).filter(j => {
        if (j.application_deadline && new Date(j.application_deadline) < now) return false;
        if (j.expires_at && new Date(j.expires_at) < now) return false;
        return true;
      });

      setJobs(unexpired as any);
    } catch (e: any) {
      console.error('Job fetch exception:', e);
      setErrorState(e?.message || 'Error communicating with database');
      setJobs([]);
    } finally {
      setLoading(false);
    }
  };

  // Pre-calculate counts by category for tab indicators
  const categoryCounts = useMemo(() => {
    const counts = { all: jobs.length, tech: 0, 'non-tech': 0, core: 0 };
    jobs.forEach(j => {
      const cat = categorizeJob(j.title, j.company_name, j.department, j.industry);
      counts[cat]++;
    });
    return counts;
  }, [jobs]);

  // Filtered jobs based on Category, Location & Search Term
  const filteredJobs = useMemo(() => {
    return jobs.filter(job => {
      // Saved tab view
      if (activeTab === 'saved' && !savedJobIds.includes(job.id)) return false;

      // Category check (only on discover view when specific category selected)
      if (activeTab === 'discover' && activeCategory !== 'all') {
        const jobCategory = categorizeJob(job.title, job.company_name, job.department, job.industry);
        if (jobCategory !== activeCategory) return false;
      }

      // City filter
      if (selectedCity !== 'all') {
        const loc = `${job.location_city || ''} ${job.location || ''}`.toLowerCase();
        if (selectedCity === 'remote') {
          if (!job.is_remote && !loc.includes('remote')) return false;
        } else if (!loc.includes(selectedCity.toLowerCase())) {
          return false;
        }
      }

      // Work mode filter
      if (selectedWorkMode === 'remote' && !job.is_remote && !(job.location || '').toLowerCase().includes('remote')) return false;
      if (selectedWorkMode === 'hybrid' && !(job.location || '').toLowerCase().includes('hybrid')) return false;

      // Salary filter
      if (selectedSalary !== 'all') {
        const minLakhs = (job.salary_min || 0) / 100000;
        if (selectedSalary === '3lpa' && minLakhs < 3) return false;
        if (selectedSalary === '6lpa' && minLakhs < 6) return false;
        if (selectedSalary === '10lpa' && minLakhs < 10) return false;
        if (selectedSalary === '20lpa' && minLakhs < 20) return false;
      }

      // Employment type filter
      if (selectedEmploymentType !== 'all') {
        const emp = (job.employment_type || '').toLowerCase();
        if (!emp.includes(selectedEmploymentType.toLowerCase())) return false;
      }

      // Search query filter
      if (searchTerm.trim()) {
        const query = searchTerm.toLowerCase().trim();
        const skillsText = (job.skills_required || []).join(' ').toLowerCase();
        const searchableText = `${job.title} ${job.company_name} ${job.location} ${job.department || ''} ${job.industry || ''} ${skillsText}`.toLowerCase();
        if (!searchableText.includes(query)) return false;
      }

      return true;
    });
  }, [jobs, activeCategory, selectedCity, selectedWorkMode, selectedSalary, selectedEmploymentType, searchTerm, activeTab, savedJobIds]);

  // Reset page to 1 when filters change
  useEffect(() => {
    setCurrentPage(1);
  }, [searchTerm, selectedCity, selectedWorkMode, selectedSalary, selectedEmploymentType, activeCategory]);

  const sortedJobs = useMemo(() => {
    const list = [...filteredJobs];
    if (sortBy === 'salary_high') {
      list.sort((a, b) => (b.salary_max || b.salary_min || 0) - (a.salary_max || a.salary_min || 0));
    } else if (sortBy === 'experience') {
      list.sort((a, b) => (a.min_experience || 0) - (b.min_experience || 0));
    } else {
      list.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
    }
    return list;
  }, [filteredJobs, sortBy]);

  const totalPages = Math.ceil(sortedJobs.length / pageSize) || 1;
  const paginatedJobs = useMemo(() => {
    const start = (currentPage - 1) * pageSize;
    return sortedJobs.slice(start, start + pageSize);
  }, [sortedJobs, currentPage]);

  const handleApplyClick = (job: JobDetailItem) => {
    setSelectedJobForApply(job);
    conversionTelemetry.track('job_apply_clicked', { job_id: job.id, job_title: job.title });
  };

  const toggleSaveJob = (jobId: string, e?: React.MouseEvent) => {
    if (e) e.stopPropagation();
    setSavedJobIds(prev => {
      const updated = prev.includes(jobId) ? prev.filter(id => id !== jobId) : [...prev, jobId];
      try {
        localStorage.setItem('txc_saved_jobs', JSON.stringify(updated));
      } catch {}
      toast.success(prev.includes(jobId) ? 'Job removed from saved list' : 'Job saved to your bookmarks!');
      return updated;
    });
  };

  const handleJobPublished = (newJob: JobDetailItem) => {
    setJobs(prev => [newJob, ...prev]);
  };

  return (
    <div className="min-h-screen bg-[#F4F7FC] text-[#111827] flex flex-col font-sans selection:bg-[#2563EB] selection:text-white">
      <Helmet>
        <title>JobMatch OS by TalentXcel — Verified Employment Ecosystem</title>
        <meta 
          name="description" 
          content="Next-generation employment platform with AI JobMatch compatibility scoring, authentic verified vacancies, 1-Click direct applications, and dedicated employer & recruiter workspaces." 
        />
        <link rel="canonical" href="https://jobs.talentxcel.in/" />
      </Helmet>

      {/* Simple, Clean Public Header + Contextual Sub-Nav (Founder Directive) */}
      <JobPortalHeader 
        activeTab={activeTab === 'discover' ? 'find' : activeTab}
        onSelectTab={(tab) => {
          if (tab === 'find') setActiveTab('discover');
          else if (tab === 'profile' || tab === 'preferences') setActiveTab('match');
          else if (tab === 'applications' || tab === 'tracker') setActiveTab('tracker');
          else if (tab === 'saved') setActiveTab('saved');
          else if (tab === 'post' || tab === 'employer') setActiveTab('employer');
          else if (tab === 'talent') setActiveTab('talent');
          else if (tab === 'interview') setActiveTab('interview');
          else setActiveTab(tab);
        }}
        savedJobsCount={savedJobIds.length}
        applicationsCount={trackedApplicationsCount}
      />

      {/* Main Content Area */}
      <main className="flex-1">
        {/* VIEW 1: DISCOVER JOBS */}
        {activeTab === 'discover' && (
          <div>
            {/* Hero Section with Job Seeker Visual (Founder Directive) */}
            <section id="search-hero" className="bg-gradient-to-b from-white via-white to-[#F4F7FC] border-b border-[#E2E8F0] px-4 pt-8 pb-12">
              <div className="max-w-7xl mx-auto">
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
                  
                  {/* Left Column: Value Proposition & Premium Search */}
                  <div className="lg:col-span-7 space-y-4 text-left">
                    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#2563EB] text-xs font-bold shadow-2xs">
                      <Sparkles className="w-3.5 h-3.5 text-[#2563EB]" />
                      <span>1-Click Direct Apply with Verified Career Passport</span>
                    </div>

                    <h1 className="text-3xl sm:text-4xl lg:text-5xl font-black text-[#111827] tracking-tight leading-[1.12]">
                      Find Your Next <br />
                      <span className="bg-gradient-to-r from-[#2563EB] to-[#7138E8] bg-clip-text text-transparent">
                        Verified Job Match
                      </span>
                    </h1>

                    <p className="text-[#64748B] text-sm sm:text-base leading-relaxed max-w-xl">
                      Zero ghost listings. Every vacancy is verified with authentic application links, transparent compensation benchmarks, and direct employer routing.
                    </p>

                    {/* Premium Search Container */}
                    <div className="bg-white border border-[#E2E8F0] rounded-2xl p-2.5 sm:p-3 flex flex-col sm:flex-row gap-2 shadow-lg shadow-blue-900/5 mt-2">
                      <div className="flex-1 flex items-center gap-2.5 px-3 py-1 bg-[#F4F7FC] rounded-xl border border-[#E2E8F0] focus-within:border-[#2563EB] transition-colors">
                        <Search className="w-4 h-4 text-[#64748B] shrink-0" />
                        <Input 
                          type="text" 
                          placeholder="Job title, skill (e.g. React, Marketing, SRE, Trainee)..." 
                          value={searchTerm}
                          onChange={(e) => setSearchTerm(e.target.value)}
                          className="border-0 bg-transparent text-sm focus-visible:ring-0 text-[#111827] placeholder:text-[#64748B] p-0 h-9"
                        />
                      </div>

                      <div className="w-full sm:w-52 flex items-center gap-2 px-3 py-1 bg-[#F4F7FC] rounded-xl border border-[#E2E8F0] focus-within:border-[#2563EB] transition-colors">
                        <MapPin className="w-4 h-4 text-[#64748B] shrink-0" />
                        <select 
                          value={selectedCity}
                          onChange={(e) => setSelectedCity(e.target.value)}
                          className="w-full bg-transparent text-xs font-medium text-[#111827] border-0 focus:outline-hidden cursor-pointer h-9"
                        >
                          <option value="all">All Locations (India & Global)</option>
                          <option value="bangalore">Bengaluru / Bangalore</option>
                          <option value="hyderabad">Hyderabad</option>
                          <option value="pune">Pune</option>
                          <option value="noida">Noida / Delhi-NCR</option>
                          <option value="mumbai">Mumbai</option>
                          <option value="chennai">Chennai</option>
                          <option value="kolkata">Kolkata</option>
                          <option value="remote">Remote / Work from Home</option>
                        </select>
                      </div>

                      <Button 
                        onClick={() => {}}
                        className="bg-gradient-to-r from-[#2563EB] to-[#7138E8] hover:opacity-95 text-white font-bold text-xs px-7 py-3 rounded-xl shadow-xs transition-all shrink-0 h-10 cursor-pointer"
                      >
                        Find Jobs
                      </Button>
                    </div>

                    {/* Quick Micro-Filters Row */}
                    <div className="flex flex-wrap items-center justify-between gap-2 pt-2 text-xs">
                      <div className="flex flex-wrap items-center gap-2">
                        <select 
                          value={selectedSalary}
                          onChange={(e) => setSelectedSalary(e.target.value)}
                          className="bg-white border border-[#E2E8F0] rounded-xl px-2.5 py-1 text-xs font-semibold text-[#111827] focus:outline-hidden cursor-pointer"
                        >
                          <option value="all">Any Salary</option>
                          <option value="3lpa">₹3L+ LPA</option>
                          <option value="6lpa">₹6L+ LPA</option>
                          <option value="10lpa">₹10L+ LPA</option>
                          <option value="20lpa">₹20L+ LPA</option>
                        </select>

                        <select 
                          value={selectedWorkMode}
                          onChange={(e) => setSelectedWorkMode(e.target.value)}
                          className="bg-white border border-[#E2E8F0] rounded-xl px-2.5 py-1 text-xs font-semibold text-[#111827] focus:outline-hidden cursor-pointer"
                        >
                          <option value="all">Any Work Mode</option>
                          <option value="remote">Remote Only</option>
                          <option value="hybrid">Hybrid</option>
                        </select>

                        <select 
                          value={selectedExperience}
                          onChange={(e) => setSelectedExperience(e.target.value)}
                          className="bg-white border border-[#E2E8F0] rounded-xl px-2.5 py-1 text-xs font-semibold text-[#111827] focus:outline-hidden cursor-pointer"
                        >
                          <option value="all">Any Experience</option>
                          <option value="fresher">Fresher (0 - 1 Yrs)</option>
                          <option value="1-3">1 - 3 Yrs (Mid)</option>
                          <option value="3-5">3 - 5 Yrs (Senior)</option>
                          <option value="5+">5+ Yrs (Lead/Principal)</option>
                        </select>

                        <select 
                          value={selectedEmploymentType}
                          onChange={(e) => setSelectedEmploymentType(e.target.value)}
                          className="bg-white border border-[#E2E8F0] rounded-xl px-2.5 py-1 text-xs font-semibold text-[#111827] focus:outline-hidden cursor-pointer"
                        >
                          <option value="all">All Job Types</option>
                          <option value="full-time">Full-Time</option>
                          <option value="part-time">Part-Time</option>
                          <option value="contract">Contract</option>
                          <option value="internship">Internship</option>
                        </select>

                        <select 
                          value={sortBy}
                          onChange={(e) => setSortBy(e.target.value as any)}
                          className="bg-white border border-[#E2E8F0] rounded-xl px-2.5 py-1 text-xs font-semibold text-[#2563EB] focus:outline-hidden cursor-pointer"
                        >
                          <option value="latest">Sort: Latest</option>
                          <option value="salary_high">Sort: Highest CTC</option>
                          <option value="experience">Sort: Min Exp</option>
                        </select>

                        <button
                          type="button"
                          onClick={() => setActiveTab('saved')}
                          className="px-3 py-1 rounded-xl text-xs font-bold transition-all border flex items-center gap-1.5 bg-white text-[#64748B] border-[#E2E8F0] hover:text-[#111827] cursor-pointer"
                        >
                          <Bookmark className="w-3.5 h-3.5" />
                          <span>Saved Vacancies ({savedJobIds.length})</span>
                        </button>
                      </div>

                      <button
                        type="button"
                        onClick={() => setActiveTab('match')}
                        className="text-xs text-[#2563EB] hover:text-[#7138E8] font-bold flex items-center gap-1 hover:underline ml-auto cursor-pointer"
                      >
                        <Sparkles className="w-3.5 h-3.5" />
                        <span>Run AI Compatibility Match →</span>
                      </button>
                    </div>

                    {/* Live Verified Inventory Status Strip */}
                    <div className="pt-2 flex flex-wrap items-center gap-3 text-xs text-[#64748B] font-semibold border-t border-slate-100">
                      <span className="flex items-center gap-1.5 text-emerald-700">
                        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" />
                        <span>{totalCount.toLocaleString()}+ Active Vacancies</span>
                      </span>
                      <span>•</span>
                      <span className="flex items-center gap-1.5 text-[#2563EB]">
                        <Building2 className="w-3.5 h-3.5 text-[#2563EB]" />
                        <span>297 Verified Employers</span>
                      </span>
                      <span>•</span>
                      <span className="text-slate-500">Pan-India & Remote</span>
                    </div>
                  </div>

                  {/* Right Column: Confident Job Seeker Hero Visual with Badges */}
                  <div className="lg:col-span-5 hidden lg:flex flex-col items-center justify-center">
                    <div className="relative w-full max-w-[460px] rounded-3xl overflow-hidden shadow-xl border border-blue-100 bg-gradient-to-tr from-blue-50/50 via-white to-indigo-50/30 group">
                      <img 
                        src="/hero-character-jobseeker.jpg" 
                        onError={(e) => { (e.currentTarget).src = '/hero-character-full.webp'; }}
                        alt="TalentXcel Verified Job Seeker"
                        className="w-full h-[360px] object-cover object-top select-none transition-transform duration-500 group-hover:scale-[1.02]"
                        loading="eager"
                      />

                      {/* Floating Badge 1: Top Right */}
                      <div className="absolute top-4 right-4 bg-white/90 backdrop-blur-md border border-white/80 p-2.5 rounded-2xl shadow-lg flex items-center gap-2.5">
                        <div className="w-8 h-8 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold shadow-xs">
                          <CheckCircle2 className="w-4 h-4" />
                        </div>
                        <div className="text-left">
                          <div className="text-xs font-black text-[#111827]">{totalCount.toLocaleString()}+ Verified</div>
                          <div className="text-[10px] text-emerald-600 font-bold">Active Openings</div>
                        </div>
                      </div>

                      {/* Floating Badge 2: Bottom Left with Logos */}
                      <div className="absolute bottom-4 left-4 bg-white/90 backdrop-blur-md border border-white/80 p-2.5 rounded-2xl shadow-lg flex items-center gap-2.5">
                        <div className="flex -space-x-1.5">
                          <CompanyLogoAvatar companyName="Google" size="sm" className="border-2 border-white" />
                          <CompanyLogoAvatar companyName="TCS" size="sm" className="border-2 border-white" />
                          <CompanyLogoAvatar companyName="Infosys" size="sm" className="border-2 border-white" />
                          <CompanyLogoAvatar companyName="BHEL" size="sm" className="border-2 border-white" />
                        </div>
                        <div className="text-left">
                          <div className="text-xs font-black text-[#111827]">297 Employers</div>
                          <div className="text-[10px] text-[#2563EB] font-bold">Hiring Now</div>
                        </div>
                      </div>

                      {/* Floating Badge 3: Bottom Right */}
                      <div className="absolute bottom-4 right-4 bg-gradient-to-r from-[#2563EB] to-[#7138E8] text-white px-3 py-1.5 rounded-xl text-xs font-bold shadow-md flex items-center gap-1.5">
                        <Zap className="w-3.5 h-3.5 text-amber-300" />
                        <span>Fast Apply</span>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </section>

            {/* Tri-Industry Segment Tabs & Listings */}
            <section className="px-4 max-w-5xl mx-auto py-10">
              <Tabs 
                value={activeCategory} 
                onValueChange={(val) => setActiveCategory(val as any)}
                className="w-full"
              >
                {/* White Pill Tab Bar */}
                <div className="flex justify-center mb-6">
                  <TabsList className="bg-white border border-[#E2E8F0] p-1.5 rounded-2xl shadow-xs flex flex-wrap justify-center gap-1 h-auto">
                    <TabsTrigger 
                      value="all" 
                      className="text-xs font-bold px-4 py-2 rounded-xl text-[#64748B] data-[state=active]:bg-gradient-to-r data-[state=active]:from-[#2563EB] data-[state=active]:to-[#7138E8] data-[state=active]:text-white transition-all flex items-center gap-2"
                    >
                      <Sparkles className="w-3.5 h-3.5" />
                      <span>All Vacancies</span>
                      <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-[#64748B]">
                        {categoryCounts.all || totalCount}
                      </span>
                    </TabsTrigger>
                    <TabsTrigger 
                      value="tech" 
                      className="text-xs font-bold px-4 py-2 rounded-xl text-[#64748B] data-[state=active]:bg-gradient-to-r data-[state=active]:from-[#2563EB] data-[state=active]:to-[#7138E8] data-[state=active]:text-white transition-all flex items-center gap-2"
                    >
                      <Cpu className="w-3.5 h-3.5" />
                      <span>Tech & IT Jobs</span>
                      <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-[#64748B]">
                        {categoryCounts.tech}
                      </span>
                    </TabsTrigger>
                    <TabsTrigger 
                      value="non-tech" 
                      className="text-xs font-bold px-4 py-2 rounded-xl text-[#64748B] data-[state=active]:bg-gradient-to-r data-[state=active]:from-[#2563EB] data-[state=active]:to-[#7138E8] data-[state=active]:text-white transition-all flex items-center gap-2"
                    >
                      <Briefcase className="w-3.5 h-3.5" />
                      <span>Non-Tech & Business</span>
                      <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-[#64748B]">
                        {categoryCounts['non-tech']}
                      </span>
                    </TabsTrigger>
                    <TabsTrigger 
                      value="core" 
                      className="text-xs font-bold px-4 py-2 rounded-xl text-[#64748B] data-[state=active]:bg-gradient-to-r data-[state=active]:from-[#2563EB] data-[state=active]:to-[#7138E8] data-[state=active]:text-white transition-all flex items-center gap-2"
                    >
                      <HardHat className="w-3.5 h-3.5" />
                      <span>Core Engineering & PSU</span>
                      <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-[#64748B]">
                        {categoryCounts.core}
                      </span>
                    </TabsTrigger>
                  </TabsList>
                </div>

                {/* Dynamic Status Counter Row */}
                <div className="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-[#64748B] pb-4 px-1 gap-2 font-medium">
                  <span>
                    Showing <strong className="text-[#111827]">{filteredJobs.length}</strong> of{' '}
                    <strong className="text-[#111827]">{totalCount.toLocaleString()}</strong> verified active vacancies
                  </span>
                  {(searchTerm || selectedCity !== 'all' || selectedSalary !== 'all' || selectedWorkMode !== 'all' || activeCategory !== 'all') && (
                    <button
                      onClick={() => {
                        setSearchTerm('');
                        setSelectedCity('all');
                        setSelectedSalary('all');
                        setSelectedWorkMode('all');
                        setActiveCategory('all');
                      }}
                      className="text-[#2563EB] hover:text-[#7138E8] font-bold flex items-center gap-1 cursor-pointer self-start sm:self-auto hover:underline"
                    >
                      <RotateCcw className="w-3 h-3" />
                      <span>Reset all filters ({totalCount.toLocaleString()} total)</span>
                    </button>
                  )}
                </div>

                {/* Job Cards Grid */}
                <div className="space-y-4">
                  {errorState ? (
                    <div className="bg-white border border-red-200 p-8 rounded-2xl text-center space-y-3">
                      <div className="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center mx-auto font-bold text-lg">!</div>
                      <h4 className="font-bold text-base text-[#111827]">Unable to load vacancies from database</h4>
                      <p className="text-xs text-[#64748B] max-w-md mx-auto">{errorState}</p>
                      <Button size="sm" onClick={fetchJobs} className="bg-[#2563EB] text-white text-xs rounded-xl">
                        Retry Connection
                      </Button>
                    </div>
                  ) : loading ? (
                    <div className="p-12 text-center text-xs font-semibold text-[#64748B] space-y-2">
                      <Clock className="w-6 h-6 text-[#2563EB] animate-spin mx-auto" />
                      <div>Loading verified vacancies from Supabase...</div>
                    </div>
                  ) : filteredJobs.length === 0 ? (
                    <div className="bg-white border border-[#E2E8F0] p-10 rounded-2xl text-center space-y-3">
                      <Briefcase className="w-10 h-10 text-slate-300 mx-auto" />
                      <h4 className="font-bold text-base text-[#111827]">No vacancies found matching your filters</h4>
                      <p className="text-xs text-[#64748B]">
                        Out of {totalCount.toLocaleString()} verified active vacancies, none matched your current filter criteria.
                      </p>
                      <Button
                        size="sm"
                        onClick={() => {
                          setSearchTerm('');
                          setSelectedCity('all');
                          setSelectedSalary('all');
                          setSelectedWorkMode('all');
                          setActiveCategory('all');
                        }}
                        className="text-xs bg-[#2563EB] text-white rounded-xl"
                      >
                        Reset All Filters (Show All {totalCount.toLocaleString()})
                      </Button>
                    </div>
                  ) : (
                    paginatedJobs.map(job => {
                      const isSaved = savedJobIds.includes(job.id);
                      const salaryText = formatSalary(job.salary_min, job.salary_max);

                      return (
                        <Card 
                          key={job.id}
                          className="bg-white border-[#E2E8F0] hover:border-[#2563EB] transition-all rounded-2xl p-5 shadow-xs hover:shadow-md text-left flex flex-col sm:flex-row sm:items-center justify-between gap-4 cursor-pointer"
                          onClick={() => setSelectedJobForDetail(job)}
                        >
                          <div className="flex items-start sm:items-center gap-3.5 sm:gap-4 min-w-0 flex-1">
                            <CompanyLogoAvatar companyName={job.company_name} size="lg" className="mt-0.5 shrink-0" />
                            <div className="space-y-1.5 min-w-0 flex-1">
                              <div className="flex items-center gap-2 flex-wrap">
                                <span className="text-xs font-bold text-[#2563EB] bg-blue-50 px-2 py-0.5 rounded-md border border-blue-200">
                                  {job.company_name}
                                </span>
                                <Badge variant="outline" className="text-emerald-700 bg-emerald-50 border-emerald-200 text-[10px] font-bold">
                                  Verified
                                </Badge>
                                {job.is_remote && (
                                  <Badge variant="outline" className="text-purple-700 bg-purple-50 border-purple-200 text-[10px] font-bold">
                                    Remote
                                  </Badge>
                                )}
                              </div>

                              <h3 className="font-bold text-base sm:text-lg text-[#111827] hover:text-[#2563EB] transition-colors leading-snug">
                                {job.title}
                              </h3>

                            <div className="flex items-center gap-3 text-xs text-[#64748B] flex-wrap">
                              <span className="flex items-center gap-1"><MapPin className="w-3.5 h-3.5" />{job.location || 'India'}</span>
                              {salaryText && (
                                <>
                                  <span>•</span>
                                  <span className="font-semibold text-emerald-700">{salaryText}</span>
                                </>
                              )}
                              <span>•</span>
                              <span>{job.employment_type || 'Full-Time'}</span>
                            </div>

                            {job.skills_required && job.skills_required.length > 0 && (
                              <div className="flex flex-wrap gap-1 pt-1">
                                {job.skills_required.slice(0, 4).map((s, idx) => (
                                  <span key={idx} className="text-[10px] bg-[#F4F7FC] text-[#475569] border border-[#E2E8F0] px-2 py-0.5 rounded-md">
                                    {s}
                                  </span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>

                          {/* Action Buttons Column */}
                          <div 
                            className="flex items-center gap-2 shrink-0 self-start sm:self-center"
                            onClick={(e) => e.stopPropagation()}
                          >
                            <Button
                              variant="outline"
                              size="sm"
                              onClick={(e) => toggleSaveJob(job.id, e)}
                              className={`h-9 w-9 p-0 rounded-xl ${isSaved ? 'text-amber-500 fill-amber-500' : 'text-[#64748B]'}`}
                              title={isSaved ? 'Saved' : 'Save Job'}
                            >
                              <Bookmark className="w-4 h-4" />
                            </Button>

                            <Button
                              variant="outline"
                              size="sm"
                              onClick={() => navigate(`/jobs/${generateSlug(job.title, job.id)}`)}
                              className="text-xs font-semibold rounded-xl text-[#2563EB] border-blue-200 hover:bg-blue-50 h-9 px-3"
                            >
                              Inspect Role →
                            </Button>

                            <Button
                              size="sm"
                              onClick={() => handleApplyClick(job)}
                              className="bg-gradient-to-r from-[#2563EB] to-[#7138E8] hover:opacity-95 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-xs h-9"
                            >
                              1-Click Apply
                            </Button>
                          </div>
                        </Card>
                      );
                    })
                  )}
                </div>
              </Tabs>

              {/* ── Pagination Controls ── */}
              {totalPages > 1 && (
                <div className="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[#E2E8F0] text-xs">
                  <span className="text-[#64748B]">
                    Showing <strong className="text-[#111827]">{(currentPage - 1) * pageSize + 1}</strong> –{' '}
                    <strong className="text-[#111827]">{Math.min(currentPage * pageSize, filteredJobs.length)}</strong> of{' '}
                    <strong className="text-[#111827]">{filteredJobs.length.toLocaleString()}</strong> matching vacancies
                  </span>

                  <div className="flex items-center gap-1.5">
                    <Button
                      variant="outline"
                      size="sm"
                      disabled={currentPage === 1}
                      onClick={() => {
                        setCurrentPage(p => Math.max(1, p - 1));
                        const el = document.getElementById('search-hero');
                        if (el) el.scrollIntoView({ behavior: 'smooth' });
                      }}
                      className="text-xs h-8 px-3 rounded-lg"
                    >
                      Previous
                    </Button>

                    {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                      let pNum = i + 1;
                      if (totalPages > 5 && currentPage > 3) {
                        pNum = currentPage - 2 + i;
                        if (pNum > totalPages) pNum = totalPages - (4 - i);
                      }
                      return (
                        <Button
                          key={pNum}
                          variant={currentPage === pNum ? 'default' : 'outline'}
                          size="sm"
                          onClick={() => {
                            setCurrentPage(pNum);
                            const el = document.getElementById('search-hero');
                            if (el) el.scrollIntoView({ behavior: 'smooth' });
                          }}
                          className={`text-xs h-8 w-8 p-0 rounded-lg ${
                            currentPage === pNum ? 'bg-[#2563EB] text-white font-bold' : 'text-[#475569]'
                          }`}
                        >
                          {pNum}
                        </Button>
                      );
                    })}

                    <Button
                      variant="outline"
                      size="sm"
                      disabled={currentPage === totalPages}
                      onClick={() => {
                        setCurrentPage(p => Math.min(totalPages, p + 1));
                        const el = document.getElementById('search-hero');
                        if (el) el.scrollIntoView({ behavior: 'smooth' });
                      }}
                      className="text-xs h-8 px-3 rounded-lg"
                    >
                      Next
                    </Button>
                  </div>
                </div>
              )}
            </section>

            {/* ── B, C, D, F, H: Complete Marketplace Discovery Grids ── */}
            <div className="py-12 border-t border-[#E2E8F0] bg-white">
              <JobPortalDiscoveryGrid 
                onSelectCategory={(cat) => {
                  setActiveCategory(cat.id === 'cat-psu' ? 'core' : cat.id.includes('soft') ? 'tech' : 'non-tech');
                  setSearchTerm(cat.name);
                  const el = document.getElementById('search-hero');
                  if (el) el.scrollIntoView({ behavior: 'smooth' });
                }}
                onSelectLocation={(loc) => {
                  setSelectedCity(loc.slug);
                  const el = document.getElementById('search-hero');
                  if (el) el.scrollIntoView({ behavior: 'smooth' });
                }}
                onSelectCompany={(comp) => {
                  setSearchTerm(comp.name);
                  const el = document.getElementById('search-hero');
                  if (el) el.scrollIntoView({ behavior: 'smooth' });
                }}
                totalActiveCount={totalCount}
                recent30DaysCount={1688}
              />
            </div>

            {/* ── G. Comprehensive Public Career Resources (Part 2-G) ── */}
            <CareerResourcesSection />
          </div>
        )}

        {/* VIEW 2: AI MATCH & PROFILE */}
        {activeTab === 'match' && (
          <div className="px-4 max-w-5xl mx-auto py-10">
            <AIMatchWorkspace
              jobs={jobs}
              onApplyJob={handleApplyClick}
              onOpenJobDetail={(j) => setSelectedJobForDetail(j)}
              isSavedJob={(id) => savedJobIds.includes(id)}
              onToggleSaveJob={(id) => toggleSaveJob(id)}
            />
          </div>
        )}

        {/* VIEW 3: APPLICATION TRACKER */}
        {activeTab === 'tracker' && (
          <div className="px-4 max-w-5xl mx-auto py-10">
            <CandidateApplicationTracker
              onBrowseJobs={() => setActiveTab('discover')}
              onLaunchInterviewPrep={(t, c) => {
                const found = jobs.find(j => j.title.toLowerCase().includes(t.toLowerCase()));
                if (found) setSelectedJobForInterview(found);
                setActiveTab('interview');
              }}
            />
          </div>
        )}

        {/* VIEW 4: SAVED JOBS */}
        {activeTab === 'saved' && (
          <div className="px-4 max-w-5xl mx-auto py-10 space-y-6 text-left">
            <div className="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
              <div>
                <h3 className="font-black text-xl text-[#111827]">Your Saved Vacancies ({savedJobIds.length})</h3>
                <p className="text-xs text-[#64748B]">Bookmarked opportunities ready for 1-click application.</p>
              </div>
              <Button
                size="sm"
                variant="outline"
                onClick={() => setActiveTab('discover')}
                className="text-xs rounded-xl"
              >
                ← Back to All Vacancies
              </Button>
            </div>

            {savedJobIds.length === 0 ? (
              <div className="bg-white border border-[#E2E8F0] rounded-2xl p-10 text-center space-y-3">
                <Bookmark className="w-10 h-10 text-slate-300 mx-auto" />
                <h4 className="font-bold text-base text-[#111827]">You haven't saved any vacancies yet</h4>
                <p className="text-xs text-[#64748B]">Click the bookmark icon on any job card to save it here for later.</p>
                <Button onClick={() => setActiveTab('discover')} className="bg-[#2563EB] text-white text-xs rounded-xl">
                  Browse Jobs
                </Button>
              </div>
            ) : (
              <div className="space-y-4">
                {jobs.filter(j => savedJobIds.includes(j.id)).map(job => (
                  <Card key={job.id} className="bg-white border-[#E2E8F0] p-5 rounded-2xl shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                      <span className="text-xs font-bold text-[#2563EB]">{job.company_name}</span>
                      <h4 className="font-bold text-base text-[#111827] mt-0.5">{job.title}</h4>
                      <div className="text-xs text-[#64748B] flex items-center gap-2 mt-1">
                        <span>{job.location}</span>
                        <span>•</span>
                        <span className="text-emerald-700 font-semibold">{formatSalary(job.salary_min, job.salary_max)}</span>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      <Button variant="outline" size="sm" onClick={() => toggleSaveJob(job.id)} className="text-xs rounded-xl">
                        Remove
                      </Button>
                      <Button size="sm" onClick={() => handleApplyClick(job)} className="bg-gradient-to-r from-[#2563EB] to-[#7138E8] text-white text-xs font-bold rounded-xl px-5">
                        1-Click Apply
                      </Button>
                    </div>
                  </Card>
                ))}
              </div>
            )}
          </div>
        )}

        {/* VIEW 5: EMPLOYER REQUISITION WORKSPACE */}
        {activeTab === 'employer' && (
          <div className="px-4 max-w-5xl mx-auto py-10">
            <EmployerRequisitionWorkspace onJobPublished={handleJobPublished} />
          </div>
        )}

        {/* VIEW 6: RECRUITER TALENT DATABASE */}
        {activeTab === 'talent' && (
          <div className="px-4 max-w-5xl mx-auto py-10">
            <RecruiterTalentSearch />
          </div>
        )}

        {/* VIEW 7: AI INTERVIEW PREP COACH */}
        {activeTab === 'interview' && (
          <div className="px-4 max-w-5xl mx-auto py-10">
            <AIInterviewPrepCoach jobs={jobs} selectedJob={selectedJobForInterview} />
          </div>
        )}
      </main>

      {/* Comprehensive Job Detail Drawer Modal */}
      <JobDetailDrawer
        job={selectedJobForDetail}
        isOpen={Boolean(selectedJobForDetail)}
        onClose={() => setSelectedJobForDetail(null)}
        onApply={(j) => {
          setSelectedJobForDetail(null);
          handleApplyClick(j);
        }}
        isSaved={selectedJobForDetail ? savedJobIds.includes(selectedJobForDetail.id) : false}
        onToggleSave={(id) => toggleSaveJob(id)}
        onLaunchMatch={(j) => {
          setSelectedJobForDetail(null);
          setActiveTab('match');
        }}
        onLaunchInterviewPrep={(j) => {
          setSelectedJobForDetail(null);
          setSelectedJobForInterview(j);
          setActiveTab('interview');
        }}
      />

      {/* 1-Click Fast Guest & Authenticated Application Modal */}
      {selectedJobForApply && (
        <GuestJobApplyModal
          open={Boolean(selectedJobForApply)}
          onOpenChange={(isOpen) => !isOpen && setSelectedJobForApply(null)}
          job={selectedJobForApply}
          onSuccess={() => {
            setSelectedJobForApply(null);
            toast.success('Application registered! Check the Application Tracker to follow its review status.');
          }}
        />
      )}

      {/* Floating Quick Launcher for All 12 Platforms */}
      <div className="fixed left-4 bottom-6 z-40 hidden sm:block">
        <button
          type="button"
          onClick={() => setPlatformSidebarOpen(true)}
          className="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/95 backdrop-blur-md border border-[#2563EB]/40 shadow-xl hover:shadow-2xl hover:scale-105 text-[#2563EB] text-xs font-black transition-all cursor-pointer group"
          title="Explore all 12 TalentXcel platforms"
        >
          <Compass className="w-4 h-4 text-[#2563EB] group-hover:rotate-90 transition-transform" />
          <span>Explore All 12 Platforms</span>
          <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
        </button>
      </div>

      {/* Slide-Out 12 Platform Ecosystem Navigation Sidebar */}
      <PlatformEcosystemSidebar 
        open={platformSidebarOpen} 
        onOpenChange={setPlatformSidebarOpen} 
      />

      {/* Shared Global Product Footer */}
      <JobPortalFooter />
    </div>
  );
};
